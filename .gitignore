# ---------------------------------------------------------------------
# Build tree
# ---------------------------------------------------------------------
# Upstream clones and all build output. Everything under work/ is fetched
# or generated by build-macos.sh and must never be committed -- it also
# contains the GPL sources of sane-airscan and AirSane, which are pulled
# from their own repositories at build time rather than vendored here.
work/

# ---------------------------------------------------------------------
# Compiled output
# ---------------------------------------------------------------------
*.o
*.obj
*.a
*.lo
*.la
*.so
*.so.*
*.dylib
*.bundle
*.dSYM/
objs/
build/
cmake-build-*/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
install_manifest.txt

# Backend and tools, if anyone builds in the repo root rather than work/
libsane-airscan.*
airscan-discover
test
test-decode
test-devcaps
test-multipart
test-uri
test-zeroconf
test-compat-eloop

# ctags / cscope, which the upstream Makefile generates
tags
TAGS
cscope.*

# ---------------------------------------------------------------------
# IDE and editor state
# ---------------------------------------------------------------------
# IntelliJ / CLion. .idea holds absolute paths and local workspace state.
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code, Xcode, vim, emacs
.vscode/
*.xcodeproj/
*.xcworkspace/
xcuserdata/
*.swp
*.swo
*~
.\#*
\#*\#

# ---------------------------------------------------------------------
# macOS
# ---------------------------------------------------------------------
.DS_Store
.AppleDouble
._*

# ---------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------
# Machine-specific paths; settings.json (shared) is fine to commit.
.claude/settings.local.json

# ---------------------------------------------------------------------
# Scratch
# ---------------------------------------------------------------------
*.log
*.bak
*.orig
*.rej
