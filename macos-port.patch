index da99890..a7953e6 100644
--- a/airscan-mdns.c
+++ b/airscan-mdns.c
@@ -8,6 +8,8 @@
 
 #include "airscan.h"
 
+#ifdef OS_HAVE_AVAHI
+
 #include <arpa/inet.h>
 #include <net/if.h>
 
@@ -1455,5 +1457,318 @@ mdns_cleanup (void)
     mdns_log = NULL;
 }
 
+
+#else /* !OS_HAVE_AVAHI -- Darwin */
+
+/* mDNS discovery via avahi-client is unavailable on Darwin: avahi is a
+ * Linux daemon and is not packaged for macOS.
+ *
+ * Browsing (finding eSCL scanners by service type) is therefore not
+ * provided. That costs nothing for WSD-only devices, which are found by
+ * WS-Discovery multicast in airscan-wsdd.c -- a path that never touches
+ * avahi.
+ *
+ * Hostname resolution IS provided, because airscan-wsdd.c depends on it
+ * to turn a WSD-discovered hostname into addresses. It is implemented
+ * with getaddrinfo(3), which on macOS resolves ".local" names through
+ * mDNSResponder -- so this is a real implementation, not a placeholder.
+ *
+ * getaddrinfo(3) blocks, so each query runs on a detached worker thread
+ * and posts its result back to the event loop thread via eloop_call().
+ */
+
+#include <netdb.h>
+#include <pthread.h>
+#include <string.h>
+
+/* Query state, shared between the event loop thread and its worker.
+ * Protected by mdns_stub_mutex. Refcounted: one reference for the
+ * resolver's list, one for the worker thread.
+ */
+struct mdns_query {
+    mdns_resolver *resolver;
+    char          *name;
+    void          (*callback) (const mdns_query *query);
+    void          *ptr;
+    ip_addrset    *answer;
+    unsigned      refcnt;
+    bool          cancelled;
+    bool          finished;
+    mdns_query    *next;
+};
+
+struct mdns_resolver {
+    int        ifindex;
+    mdns_query *queries;
+};
+
+static pthread_mutex_t mdns_stub_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+/* Drop a reference; free when it hits zero. Caller must hold the mutex. */
+static void
+mdns_query_unref (mdns_query *query)
+{
+    if (-- query->refcnt != 0) {
+        return;
+    }
+
+    ip_addrset_free(query->answer);
+    mem_free(query->name);
+    mem_free(query);
+}
+
+/* Detach a query from its resolver's list. Caller must hold the mutex. */
+static void
+mdns_query_detach (mdns_query *query)
+{
+    mdns_query **p;
+
+    if (query->resolver == NULL) {
+        return;
+    }
+
+    for (p = &query->resolver->queries; *p != NULL; p = &(*p)->next) {
+        if (*p == query) {
+            *p = query->next;
+            break;
+        }
+    }
+
+    query->resolver = NULL;
+    query->next     = NULL;
+}
+
+/* Runs on the event loop thread once the worker is done */
+static void
+mdns_stub_complete (void *data)
+{
+    mdns_query *query = data;
+    bool       fire;
+
+    pthread_mutex_lock(&mdns_stub_mutex);
+    fire = !query->cancelled;
+    if (fire) {
+        query->finished = true;
+        mdns_query_detach(query);
+    }
+    pthread_mutex_unlock(&mdns_stub_mutex);
+
+    /* The callback is invoked without the mutex held: it is allowed to
+     * call back into this module (e.g. to submit another query).
+     */
+    if (fire && query->callback != NULL) {
+        query->callback(query);
+    }
+
+    pthread_mutex_lock(&mdns_stub_mutex);
+    mdns_query_unref(query);
+    pthread_mutex_unlock(&mdns_stub_mutex);
+}
+
+/* Worker thread: resolve the name, then hand back to the event loop */
+static void*
+mdns_stub_worker (void *data)
+{
+    mdns_query      *query = data;
+    struct addrinfo hints;
+    struct addrinfo *result = NULL, *ai;
+    int             ifindex, rc;
+
+    memset(&hints, 0, sizeof(hints));
+    hints.ai_family   = AF_UNSPEC;
+    hints.ai_socktype = SOCK_STREAM;
+
+    pthread_mutex_lock(&mdns_stub_mutex);
+    ifindex = query->resolver != NULL ? query->resolver->ifindex : 0;
+    pthread_mutex_unlock(&mdns_stub_mutex);
+
+    rc = getaddrinfo(query->name, NULL, &hints, &result);
+
+    pthread_mutex_lock(&mdns_stub_mutex);
+    if (rc == 0) {
+        for (ai = result; ai != NULL; ai = ai->ai_next) {
+            if (ai->ai_family == AF_INET) {
+                struct sockaddr_in *sin = (struct sockaddr_in*) ai->ai_addr;
+                ip_addrset_add(query->answer,
+                    ip_addr_make(ifindex, AF_INET, &sin->sin_addr));
+            } else if (ai->ai_family == AF_INET6) {
+                struct sockaddr_in6 *sin6 =
+                    (struct sockaddr_in6*) ai->ai_addr;
+                ip_addrset_add(query->answer,
+                    ip_addr_make(ifindex, AF_INET6, &sin6->sin6_addr));
+            }
+        }
+    } else {
+        log_debug(NULL, "mdns: getaddrinfo(\"%s\"): %s",
+            query->name, gai_strerror(rc));
+    }
+    pthread_mutex_unlock(&mdns_stub_mutex);
+
+    if (result != NULL) {
+        freeaddrinfo(result);
+    }
+
+    eloop_call(mdns_stub_complete, query);
+
+    return NULL;
+}
+
+mdns_resolver*
+mdns_resolver_new (int ifindex)
+{
+    mdns_resolver *resolver = mem_new(mdns_resolver, 1);
+
+    resolver->ifindex = ifindex;
+    resolver->queries = NULL;
+
+    return resolver;
+}
+
+void
+mdns_resolver_free (mdns_resolver *resolver)
+{
+    if (resolver == NULL) {
+        return;
+    }
+
+    mdns_resolver_cancel(resolver);
+    mem_free(resolver);
+}
+
+void
+mdns_resolver_cancel (mdns_resolver *resolver)
+{
+    pthread_mutex_lock(&mdns_stub_mutex);
+
+    while (resolver->queries != NULL) {
+        mdns_query *query = resolver->queries;
+
+        query->cancelled = true;
+        mdns_query_detach(query);
+        mdns_query_unref(query); /* drop the list's reference */
+    }
+
+    pthread_mutex_unlock(&mdns_stub_mutex);
+}
+
+bool
+mdns_resolver_has_pending (mdns_resolver *resolver)
+{
+    bool pending;
+
+    pthread_mutex_lock(&mdns_stub_mutex);
+    pending = resolver->queries != NULL;
+    pthread_mutex_unlock(&mdns_stub_mutex);
+
+    return pending;
+}
+
+mdns_query*
+mdns_query_submit (mdns_resolver *resolver,
+                   const char *name,
+                   void (*callback)(const mdns_query *query),
+                   void *ptr)
+{
+    mdns_query *query = mem_new(mdns_query, 1);
+    pthread_t  thread;
+    pthread_attr_t attr;
+    int        rc;
+
+    query->resolver  = resolver;
+    query->name      = str_dup(name);
+    query->callback  = callback;
+    query->ptr       = ptr;
+    query->answer    = ip_addrset_new();
+    query->cancelled = false;
+    query->finished  = false;
+    query->refcnt    = 2; /* one for the list, one for the worker */
+
+    pthread_mutex_lock(&mdns_stub_mutex);
+    query->next       = resolver->queries;
+    resolver->queries = query;
+    pthread_mutex_unlock(&mdns_stub_mutex);
+
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    rc = pthread_create(&thread, &attr, mdns_stub_worker, query);
+    pthread_attr_destroy(&attr);
+
+    if (rc != 0) {
+        /* Could not start the worker: complete with an empty answer
+         * rather than leaving the query pending forever.
+         */
+        log_debug(NULL, "mdns: pthread_create: %s", strerror(rc));
+        eloop_call(mdns_stub_complete, query);
+    }
+
+    return query;
+}
+
+void
+mdns_query_cancel (mdns_query *query)
+{
+    pthread_mutex_lock(&mdns_stub_mutex);
+
+    if (!query->cancelled && !query->finished) {
+        query->cancelled = true;
+        mdns_query_detach(query);
+        mdns_query_unref(query); /* drop the list's reference */
+    }
+
+    pthread_mutex_unlock(&mdns_stub_mutex);
+}
+
+const char*
+mdns_query_get_name (const mdns_query *query)
+{
+    return query->name;
+}
+
+const ip_addrset*
+mdns_query_get_answer (const mdns_query *query)
+{
+    return query->answer;
+}
+
+void*
+mdns_query_get_ptr (const mdns_query *query)
+{
+    return query->ptr;
+}
