diff --git a/airscan-compat-avahi.c b/airscan-compat-avahi.c
new file mode 100644
index 0000000..8774b71
--- /dev/null
+++ b/airscan-compat-avahi.c
@@ -0,0 +1,906 @@
+/* AirScan (a.k.a. eSCL) backend for SANE -- macOS compatibility layer
+ *
+ * Implementation of the avahi-common subset used by sane-airscan,
+ * backed by poll(2). See airscan-compat-avahi.h for scope.
+ */
+
+#include "airscan.h"
+
+#ifndef OS_HAVE_AVAHI
+
+#include <arpa/inet.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <fcntl.h>
+
+/* write() to the wakeup pipe is intentionally best-effort */
+#pragma GCC diagnostic ignored "-Wunused-result"
+
+/******************** Address formatting ********************/
+char*
+avahi_address_snprint (char *ret_s, size_t length, const AvahiAddress *a)
+{
+    if (ret_s == NULL || length == 0 || a == NULL) {
+        return NULL;
+    }
+
+    switch (a->proto) {
+    case AVAHI_PROTO_INET:
+        if (inet_ntop(AF_INET, &a->data.ipv4.address, ret_s, length) == NULL) {
+            return NULL;
+        }
+        break;
+
+    case AVAHI_PROTO_INET6:
+        if (inet_ntop(AF_INET6, a->data.ipv6.address, ret_s, length) == NULL) {
+            return NULL;
+        }
+        break;
+
+    default:
+        return NULL;
+    }
+
+    return ret_s;
+}
+
+/******************** Domain name helpers ********************/
+/* Strip one trailing dot, lowercase-compare label by label.
+ * This is a deliberately simplified form of avahi_domain_equal():
+ * sane-airscan only uses it to compare a URI host against a
+ * certificate/discovery host, never to parse escaped DNS wire names.
+ */
+int
+avahi_domain_equal (const char *a, const char *b)
+{
+    size_t la, lb;
+
+    if (a == NULL || b == NULL) {
+        return a == b;
+    }
+
+    la = strlen(a);
+    lb = strlen(b);
+
+    while (la > 0 && a[la - 1] == '.') {
+        la --;
+    }
+
+    while (lb > 0 && b[lb - 1] == '.') {
+        lb --;
+    }
+
+    if (la != lb) {
+        return 0;
+    }
+
+    return strncasecmp(a, b, la) == 0;
+}
+
+int
+avahi_is_valid_domain_name (const char *t)
+{
+    size_t len, i;
+    size_t label = 0;
+
+    if (t == NULL) {
+        return 0;
+    }
+
+    len = strlen(t);
+    if (len == 0 || len > 255) {
+        return 0;
+    }
+
+    /* A single trailing dot is allowed (fully-qualified form) */
+    if (len > 1 && t[len - 1] == '.') {
+        len --;
+    }
+
+    for (i = 0; i < len; i ++) {
+        char c = t[i];
+
+        if (c == '.') {
+            if (label == 0) {
+                return 0; /* empty label */
+            }
+            label = 0;
+            continue;
+        }
+
+        if (!(isalnum((unsigned char) c) || c == '-' || c == '_')) {
+            return 0;
+        }
+
+        if (++ label > 63) {
+            return 0;
+        }
+    }
+
+    return label != 0;
+}
+
+int
+avahi_is_valid_fqdn (const char *t)
+{
+    /* An FQDN is a valid domain name that contains at least one dot
+     * and is not a bare IP literal.
+     */
+    AvahiAddress addr;
+
+    if (!avahi_is_valid_domain_name(t)) {
+        return 0;
+    }
+
+    if (strchr(t, '.') == NULL) {
+        return 0;
+    }
+
+    if (inet_pton(AF_INET, t, &addr.data.ipv4.address) == 1) {
+        return 0;
+    }
+
+    if (inet_pton(AF_INET6, t, addr.data.ipv6.address) == 1) {
+        return 0;
+    }
+
+    return 1;
+}
+
+/******************** String list ********************/
+AvahiStringList*
+avahi_string_list_find (AvahiStringList *l, const char *key)
+{
+    size_t n;
+
+    if (key == NULL) {
+        return NULL;
+    }
+
+    n = strlen(key);
+
+    for (; l != NULL; l = l->next) {
+        if (l->size < n) {
+            continue;
+        }
+
+        if (strncasecmp((const char*) l->text, key, n) != 0) {
+            continue;
+        }
+
+        /* Match must be the whole key, or key followed by '=' */
+        if (l->size == n || l->text[n] == '=') {
+            return l;
+        }
+    }
+
+    return NULL;
+}
+
+/******************** Errors ********************/
+const char*
+avahi_strerror (int error)
+{
+    /* sane-airscan only ever feeds this values it obtained from the
+     * (absent) avahi client, so this path is unreachable in practice.
+     */
+    (void) error;
+    return "Avahi support not compiled in";
+}
+
+/******************** Time helpers ********************/
+struct timeval*
+avahi_elapse_time (struct timeval *tv, unsigned msec, unsigned jitter)
+{
+    gettimeofday(tv, NULL);
+
+    if (msec != 0) {
+        tv->tv_sec  += (time_t) (msec / 1000);
+        tv->tv_usec += (suseconds_t) ((msec % 1000) * 1000);
+    }
+
+    if (jitter != 0) {
+        tv->tv_usec += (suseconds_t) (rand() % ((int) jitter * 1000));
+    }
+
+    while (tv->tv_usec >= 1000000) {
+        tv->tv_usec -= 1000000;
+        tv->tv_sec  ++;
+    }
+
+    return tv;
+}
+
+/* Compare two struct timeval. Returns <0, 0 or >0 */
+static int
+compat_timeval_cmp (const struct timeval *a, const struct timeval *b)
+{
+    if (a->tv_sec != b->tv_sec) {
+        return a->tv_sec < b->tv_sec ? -1 : 1;
+    }
+
+    if (a->tv_usec != b->tv_usec) {
+        return a->tv_usec < b->tv_usec ? -1 : 1;
+    }
+
+    return 0;
+}
+
+/* Milliseconds from now until tv, clamped at 0 */
+static int
+compat_timeval_until (const struct timeval *tv)
+{
+    struct timeval now;
+    int64_t        ms;
+
+    gettimeofday(&now, NULL);
+
+    ms  = ((int64_t) tv->tv_sec - (int64_t) now.tv_sec) * 1000;
+    ms += ((int64_t) tv->tv_usec - (int64_t) now.tv_usec) / 1000;
+
+    if (ms < 0) {
+        return 0;
+    }
+
+    if (ms > INT_MAX) {
+        return INT_MAX;
+    }
+
+    return (int) ms;
+}
+
+/******************** Simple poll ********************/
+struct AvahiWatch {
+    AvahiSimplePoll    *simple_poll;
+    int                fd;
+    AvahiWatchEvent    events;     /* Requested events */
+    AvahiWatchEvent    revents;    /* Events reported by last poll */
+    AvahiWatchCallback callback;
+    void               *userdata;
+    int                idx;        /* Index in pollfds, or -1 */
+    bool               dead;
+    AvahiWatch         *next;
+};
+
+struct AvahiTimeout {
+    AvahiSimplePoll      *simple_poll;
+    struct timeval       expiry;
+    bool                 enabled;
+    AvahiTimeoutCallback callback;
+    void                 *userdata;
+    bool                 dead;
+    AvahiTimeout         *next;
+};
+
+struct AvahiSimplePoll {
+    AvahiPoll     api;
+    AvahiPollFunc poll_func;
+    void          *poll_func_userdata;
+
+    AvahiWatch    *watches;
+    AvahiTimeout  *timeouts;
+
+    struct pollfd *pollfds;
+    unsigned      n_pollfds;
+    unsigned      max_pollfds;
+
+    int           wakeup_pipe[2];
+
+    int           prepared_timeout;
+    bool          prepared;
+    bool          quit;
+    bool          cleanup_needed;
+};
+
+/* Default poll function, used if the caller did not install its own */
+static int
+compat_poll_func (struct pollfd *ufds, unsigned int nfds, int timeout,
+        void *userdata)
+{
+    (void) userdata;
+    return poll(ufds, nfds, timeout);
+}
+
+/* Remove watches and timeouts marked dead */
+static void
+compat_cleanup (AvahiSimplePoll *s)
+{
+    AvahiWatch   **wp;
+    AvahiTimeout **tp;
+
+    if (!s->cleanup_needed) {
+        return;
+    }
+
+    for (wp = &s->watches; *wp != NULL; ) {
+        AvahiWatch *w = *wp;
+
+        if (w->dead) {
+            *wp = w->next;
+            mem_free(w);
+        } else {
+            wp = &w->next;
+        }
+    }
+
+    for (tp = &s->timeouts; *tp != NULL; ) {
+        AvahiTimeout *t = *tp;
+
+        if (t->dead) {
+            *tp = t->next;
+            mem_free(t);
+        } else {
+            tp = &t->next;
+        }
+    }
+
+    s->cleanup_needed = false;
+}
+
+/******************** AvahiPoll vtable: watches ********************/
+static AvahiWatch*
+compat_watch_new (const AvahiPoll *api, int fd, AvahiWatchEvent event,
+        AvahiWatchCallback callback, void *userdata)
+{
+    AvahiSimplePoll *s = api->userdata;
+    AvahiWatch      *w = mem_new(AvahiWatch, 1);
+
+    w->simple_poll = s;
+    w->fd          = fd;
+    w->events      = event;
+    w->revents     = 0;
+    w->callback    = callback;
+    w->userdata    = userdata;
+    w->idx         = -1;
+    w->dead        = false;
+
+    w->next    = s->watches;
+    s->watches = w;
+
+    avahi_simple_poll_wakeup(s);
+
+    return w;
+}
+
+static void
+compat_watch_update (AvahiWatch *w, AvahiWatchEvent event)
+{
+    w->events = event;
+    avahi_simple_poll_wakeup(w->simple_poll);
+}
+
+static AvahiWatchEvent
+compat_watch_get_events (AvahiWatch *w)
+{
+    return w->revents;
+}
+
+static void
+compat_watch_free (AvahiWatch *w)
+{
+    w->dead = true;
+    w->idx  = -1;
+    w->simple_poll->cleanup_needed = true;
+}
+
+/******************** AvahiPoll vtable: timeouts ********************/
+static AvahiTimeout*
+compat_timeout_new (const AvahiPoll *api, const struct timeval *tv,
+        AvahiTimeoutCallback callback, void *userdata)
+{
+    AvahiSimplePoll *s = api->userdata;
+    AvahiTimeout    *t = mem_new(AvahiTimeout, 1);
+
+    t->simple_poll = s;
+    t->callback    = callback;
+    t->userdata    = userdata;
+    t->dead        = false;
+
+    if (tv != NULL) {
+        t->expiry  = *tv;
+        t->enabled = true;
+    } else {
+        t->enabled = false;
+    }
+
+    t->next     = s->timeouts;
+    s->timeouts = t;
+
+    avahi_simple_poll_wakeup(s);
+
+    return t;
+}
+
+static void
+compat_timeout_update (AvahiTimeout *t, const struct timeval *tv)
+{
+    if (tv != NULL) {
+        t->expiry  = *tv;
+        t->enabled = true;
+    } else {
+        t->enabled = false;
+    }
+
+    avahi_simple_poll_wakeup(t->simple_poll);
+}
+
+static void
+compat_timeout_free (AvahiTimeout *t)
+{
+    t->dead    = true;
+    t->enabled = false;
+    t->simple_poll->cleanup_needed = true;
+}
+
+/******************** Simple poll: lifecycle ********************/
+AvahiSimplePoll*
+avahi_simple_poll_new (void)
+{
+    AvahiSimplePoll *s = mem_new(AvahiSimplePoll, 1);
+    int             i;
+
+    if (pipe(s->wakeup_pipe) < 0) {
+        mem_free(s);
+        return NULL;
+    }
+
+    for (i = 0; i < 2; i ++) {
+        int flags = fcntl(s->wakeup_pipe[i], F_GETFL, 0);
+        fcntl(s->wakeup_pipe[i], F_SETFL, flags | O_NONBLOCK);
+        fcntl(s->wakeup_pipe[i], F_SETFD, FD_CLOEXEC);
+    }
+
+    s->api.userdata         = s;
+    s->api.watch_new        = compat_watch_new;
+    s->api.watch_update     = compat_watch_update;
+    s->api.watch_get_events = compat_watch_get_events;
+    s->api.watch_free       = compat_watch_free;
+    s->api.timeout_new      = compat_timeout_new;
+    s->api.timeout_update   = compat_timeout_update;
+    s->api.timeout_free     = compat_timeout_free;
+
+    s->poll_func          = compat_poll_func;
+    s->poll_func_userdata = NULL;
+
+    s->watches        = NULL;
+    s->timeouts       = NULL;
+    s->pollfds        = NULL;
+    s->n_pollfds      = 0;
+    s->max_pollfds    = 0;
+    s->prepared       = false;
+    s->quit           = false;
+    s->cleanup_needed = false;
+
+    return s;
+}
+
+void
+avahi_simple_poll_free (AvahiSimplePoll *s)
+{
+    AvahiWatch   *w;
+    AvahiTimeout *t;
+
+    if (s == NULL) {
+        return;
+    }
+
+    for (w = s->watches; w != NULL; ) {
+        AvahiWatch *next = w->next;
+        mem_free(w);
+        w = next;
+    }
+
+    for (t = s->timeouts; t != NULL; ) {
+        AvahiTimeout *next = t->next;
+        mem_free(t);
+        t = next;
+    }
+
+    close(s->wakeup_pipe[0]);
+    close(s->wakeup_pipe[1]);
+
+    mem_free(s->pollfds);
+    mem_free(s);
+}
+
+const AvahiPoll*
+avahi_simple_poll_get (AvahiSimplePoll *s)
+{
+    return &s->api;
+}
+
+void
+avahi_simple_poll_set_func (AvahiSimplePoll *s, AvahiPollFunc func,
+        void *userdata)
+{
+    s->poll_func          = func != NULL ? func : compat_poll_func;
+    s->poll_func_userdata = userdata;
+
+    avahi_simple_poll_wakeup(s);
+}
+
+void
+avahi_simple_poll_quit (AvahiSimplePoll *s)
+{
+    s->quit = true;
+    avahi_simple_poll_wakeup(s);
+}
+
+void
+avahi_simple_poll_wakeup (AvahiSimplePoll *s)
+{
+    const uint8_t c = 'w';
+
+    if (s == NULL) {
+        return;
+    }
+
+    (void) write(s->wakeup_pipe[1], &c, 1);
+}
+
+/******************** Simple poll: the loop ********************/
+int
+avahi_simple_poll_prepare (AvahiSimplePoll *s, int timeout)
+{
+    AvahiWatch      *w;
+    AvahiTimeout    *t;
+    struct timeval  *earliest = NULL;
+    unsigned        n = 0;
+    unsigned        needed;
+
+    compat_cleanup(s);
+
+    /* Count watches that want events, plus the wakeup pipe */
+    needed = 1;
+    for (w = s->watches; w != NULL; w = w->next) {
+        if (!w->dead && w->events != 0) {
+            needed ++;
+        }
+    }
+
+    if (needed > s->max_pollfds) {
+        unsigned max = s->max_pollfds != 0 ? s->max_pollfds : 8;
+
+        while (max < needed) {
+            max *= 2;
+        }
+
+        mem_free(s->pollfds);
+        s->pollfds     = mem_new(struct pollfd, max);
+        s->max_pollfds = max;
+    }
+
+    /* Slot 0 is always the wakeup pipe */
+    s->pollfds[n].fd      = s->wakeup_pipe[0];
+    s->pollfds[n].events  = POLLIN;
+    s->pollfds[n].revents = 0;
+    n ++;
+
+    for (w = s->watches; w != NULL; w = w->next) {
+        w->revents = 0;
+
+        if (w->dead || w->events == 0) {
+            w->idx = -1;
+            continue;
+        }
+
+        s->pollfds[n].fd     = w->fd;
+        s->pollfds[n].events = 0;
+
+        if (w->events & AVAHI_WATCH_IN) {
+            s->pollfds[n].events |= POLLIN;
+        }
+
+        if (w->events & AVAHI_WATCH_OUT) {
+            s->pollfds[n].events |= POLLOUT;
+        }
+
+        s->pollfds[n].revents = 0;
+        w->idx = (int) n;
+        n ++;
+    }
+
+    s->n_pollfds = n;
+
+    /* Find the earliest enabled timeout */
+    for (t = s->timeouts; t != NULL; t = t->next) {
+        if (t->dead || !t->enabled) {
+            continue;
+        }
+
+        if (earliest == NULL || compat_timeval_cmp(&t->expiry, earliest) < 0) {
+            earliest = &t->expiry;
+        }
+    }
+
+    if (earliest != NULL) {
+        int ms = compat_timeval_until(earliest);
+
+        if (timeout < 0 || ms < timeout) {
+            timeout = ms;
+        }
+    }
+
+    s->prepared_timeout = timeout;
+    s->prepared         = true;
+
+    return 0;
+}
+
+int
+avahi_simple_poll_run (AvahiSimplePoll *s)
+{
+    AvahiWatch *w;
+    int        rc;
+
+    rc = s->poll_func(s->pollfds, s->n_pollfds, s->prepared_timeout,
+            s->poll_func_userdata);
+
+    if (rc < 0) {
+        s->prepared = false;
+        return -1;
+    }
+
+    /* Drain the wakeup pipe */
+    if ((s->pollfds[0].revents & POLLIN) != 0) {
+        uint8_t buf[64];
+
+        while (read(s->wakeup_pipe[0], buf, sizeof(buf)) > 0) {
+            /* keep draining */
+        }
+    }
+
+    /* Distribute reported events back to the watches.
+     *
+     * A watch may have been created by another thread while poll() was
+     * in flight; such a watch has idx == -1 and is skipped. The fd is
+     * re-checked so that a recycled slot can never be misattributed.
+     */
+    for (w = s->watches; w != NULL; w = w->next) {
+        short revents;
+
+        if (w->dead || w->idx < 0 || (unsigned) w->idx >= s->n_pollfds) {
+            continue;
+        }
+
+        if (s->pollfds[w->idx].fd != w->fd) {
+            continue;
+        }
+
+        revents = s->pollfds[w->idx].revents;
+        w->revents = 0;
+
+        if (revents & POLLIN) {
+            w->revents |= AVAHI_WATCH_IN;
+        }
+
+        if (revents & POLLOUT) {
+            w->revents |= AVAHI_WATCH_OUT;
+        }
+
+        if (revents & POLLERR) {
+            w->revents |= AVAHI_WATCH_ERR;
+        }
+
+        if (revents & POLLHUP) {
+            w->revents |= AVAHI_WATCH_HUP;
+        }
+    }
+
+    return 0;
+}
+
+int
+avahi_simple_poll_dispatch (AvahiSimplePoll *s)
+{
+    AvahiWatch     *w;
+    AvahiTimeout   *t;
+    struct timeval now;
+
+    s->prepared = false;
+
+    /* Fire expired timeouts first.
+     *
+     * A timeout is disabled before its callback runs, matching avahi
+     * semantics: the callback is expected to re-arm it if it wants to
+     * fire again.
+     */
+    gettimeofday(&now, NULL);
+
+    for (t = s->timeouts; t != NULL; t = t->next) {
+        if (t->dead || !t->enabled) {
+            continue;
+        }
+
+        if (compat_timeval_cmp(&t->expiry, &now) > 0) {
+            continue;
+        }
+
+        t->enabled = false;
+
+        if (t->callback != NULL) {
+            t->callback(t, t->userdata);
+        }
+
+        if (s->quit) {
+            return 1;
+        }
+    }
+
+    /* Then fire watches */
+    for (w = s->watches; w != NULL; w = w->next) {
+        AvahiWatchEvent revents = w->revents;
+
+        if (w->dead || revents == 0) {
+            continue;
+        }
+
+        w->revents = 0;
+
+        if (w->callback != NULL) {
+            w->callback(w, w->fd, revents, w->userdata);
+        }
+
+        if (s->quit) {
+            return 1;
+        }
+    }
+
+    compat_cleanup(s);
+
+    return s->quit ? 1 : 0;
+}
+
+int
+avahi_simple_poll_iterate (AvahiSimplePoll *s, int timeout)
+{
+    int rc;
+
+    if (s->quit) {
+        return 1;
+    }
+
+    if (!s->prepared) {
+        rc = avahi_simple_poll_prepare(s, timeout);
+        if (rc < 0) {
+            return rc;
+        }
+    }
+
+    if (s->quit) {
+        s->prepared = false;
+        return 1;
+    }
+
+    rc = avahi_simple_poll_run(s);
+    if (rc < 0) {
+        return -1;
+    }
+
+    if (s->quit) {
+        s->prepared = false;
+        return 1;
+    }
+
+    return avahi_simple_poll_dispatch(s);
+}
+
+
+/******************** Darwin: socket / pipe shims ********************/
+#ifndef OS_HAVE_SOCK_CLOEXEC
+#undef socket
+int
+compat_socket (int domain, int type, int protocol)
+{
+    bool cloexec  = (type & SOCK_CLOEXEC) != 0;
+    bool nonblock = (type & SOCK_NONBLOCK) != 0;
+    int  fd, on = 1;
+
+    type &= ~(SOCK_CLOEXEC | SOCK_NONBLOCK);
+
+    fd = socket(domain, type, protocol);
+    if (fd < 0) {
+        return fd;
+    }
+
+    if (cloexec && fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
+        goto FAIL;
+    }
+
+    if (nonblock) {
+        int flags = fcntl(fd, F_GETFL, 0);
+
+        if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0) {
+            goto FAIL;
+        }
+    }
+
+    /* Darwin has no MSG_NOSIGNAL; SO_NOSIGPIPE is the per-socket
+     * equivalent and must be set once, here.
+     */
+#ifdef SO_NOSIGPIPE
+    (void) setsockopt(fd, SOL_SOCKET, SO_NOSIGPIPE, &on, sizeof(on));
+#else
+    (void) on;
+#endif
+
+    return fd;
+
+FAIL:
+    {
+        int err = errno;
+        close(fd);
+        errno = err;
+    }
+
+    return -1;
+}
+#endif
+
+#ifndef OS_HAVE_PIPE2
+#undef pipe2
+int
+compat_pipe2 (int fds[2], int flags)
+{
+    int i;
+
+    if (pipe(fds) < 0) {
+        return -1;
+    }
+
+    for (i = 0; i < 2; i ++) {
+        if ((flags & O_CLOEXEC) != 0 &&
+            fcntl(fds[i], F_SETFD, FD_CLOEXEC) < 0) {
+            goto FAIL;
+        }
+
+        if ((flags & O_NONBLOCK) != 0) {
+            int fl = fcntl(fds[i], F_GETFL, 0);
+
+            if (fl < 0 || fcntl(fds[i], F_SETFL, fl | O_NONBLOCK) < 0) {
+                goto FAIL;
+            }
+        }
+    }
+
+    return 0;
+
+FAIL:
+    {
+        int err = errno;
+        close(fds[0]);
+        close(fds[1]);
+        errno = err;
+    }
+
+    return -1;
+}
+#endif
+
+/******************** Darwin: memrchr ********************/
+#ifndef OS_HAVE_MEMRCHR
+/* compat_memrchr - like memchr(3), but scans backwards from the end
+ */
+void*
+compat_memrchr (const void *s, int c, size_t n)
+{
+    const unsigned char *p = (const unsigned char*) s;
+
+    while (n != 0) {
+        n --;
+        if (p[n] == (unsigned char) c) {
+            return (void*) (p + n);
+        }
+    }
+
+    return NULL;
+}
+#endif
+
+#endif /* !OS_HAVE_AVAHI */
+
+/* vim:ts=8:sw=4:et
+ */
