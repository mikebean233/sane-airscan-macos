+unsigned int
+mdns_device_count_by_model (int ifindex, const char *pattern)
+{
+    /* Without mDNS browsing there is no device inventory to consult.
+     * Reporting zero only means WSDD will not extend its discovery
+     * timeout, which is a heuristic, not a correctness requirement.
+     */
+    (void) ifindex;
+    (void) pattern;
+
+    return 0;
+}
