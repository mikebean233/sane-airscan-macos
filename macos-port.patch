+avahi_simple_poll_set_func (AvahiSimplePoll *s, AvahiPollFunc func,
+        void *userdata);
+
+int
+avahi_simple_poll_prepare (AvahiSimplePoll *s, int timeout);
+
+int
+avahi_simple_poll_run (AvahiSimplePoll *s);
+
+int
+avahi_simple_poll_dispatch (AvahiSimplePoll *s);
+
+int
+avahi_simple_poll_iterate (AvahiSimplePoll *s, int timeout);
+
+void
+avahi_simple_poll_quit (AvahiSimplePoll *s);
+
+void
+avahi_simple_poll_wakeup (AvahiSimplePoll *s);
